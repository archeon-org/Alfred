# Copy to .env for local development. Values containing "replace-with" are
# obvious non-secrets kept only so configuration validation can run.
NODE_ENV=development
POSTGRES_USER=alfred
POSTGRES_PASSWORD=replace-with-a-url-safe-local-password
MIGRATOR_DATABASE_PASSWORD=replace-with-a-url-safe-migrator-database-password
API_DATABASE_PASSWORD=replace-with-a-url-safe-api-database-password
AGENT_DATABASE_PASSWORD=replace-with-a-url-safe-agent-database-password
POSTGRES_PORT=5432
REDIS_API_PASSWORD=replace-with-a-url-safe-api-redis-password
AGENT_REDIS_PASSWORD=replace-with-a-url-safe-agent-redis-password
REDIS_PORT=6379

# NestJS API and authentication. The JWT placeholder is longer than 32
# characters but must never be used outside local configuration validation.
API_PORT=3000
API_PREFIX=api
API_CORS_ORIGINS=http://localhost:5173
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_JWT_ISSUER=alfred-api
AUTH_JWT_AUDIENCE=alfred-web
AUTH_ACCESS_TOKEN_TTL_SECONDS=300
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_SESSION_CLEANUP_INTERVAL_SECONDS=3600
AUTH_SESSION_RETENTION_SECONDS=2592000
AUTH_COOKIE_SECURE=false
AUTH_IP_RATE_LIMIT_PER_MINUTE=6000
AUTH_OAUTH_START_IP_RATE_LIMIT_PER_MINUTE=300
AUTH_OAUTH_CALLBACK_IP_RATE_LIMIT_PER_MINUTE=600
AUTH_REFRESH_IP_RATE_LIMIT_PER_MINUTE=1200
AUTH_USER_RATE_LIMIT_PER_MINUTE=120
WEB_APP_URL=http://localhost:5173
DATABASE_POOL_MAX=20
DATABASE_SSL=false
REDIS_URL=redis://default:replace-with-a-url-safe-api-redis-password@localhost:6379/0
TRUST_PROXY_HOPS=1

# Structured logs and an opt-in, token-protected Prometheus endpoint.
OBSERVABILITY_LOG_LEVEL=info
OBSERVABILITY_METRICS_ENABLED=false
OBSERVABILITY_METRICS_TOKEN=replace-with-a-dedicated-metrics-token-at-least-32-characters

# Feature flags. Optional features stay disabled until their implementation and
# environment dependencies are ready.
FEATURE_AGENT_RUNTIME_ENABLED=false
FEATURE_AG_UI_STREAMING_ENABLED=false
FEATURE_FILE_UPLOADS_ENABLED=false
FEATURE_GENERATIVE_UI_ENABLED=false
FEATURE_GOOGLE_OAUTH_ENABLED=false
FEATURE_MCP_APPS_ENABLED=false
FEATURE_RUNTIME_MEMORY_ENABLED=false
FEATURE_SKILLS_ENABLED=false
FEATURE_TEAMS_ENABLED=false

# Google OAuth is for approved external/commercial deployments. Replace all
# three placeholders before enabling its feature flag. Workspace restriction is optional.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/providers/google/callback
GOOGLE_WORKSPACE_DOMAIN=

# Public browser build configuration.
WEB_PORT=5173
VITE_API_URL=/api

# Both local `langgraph dev` and the Agent Server overlay are exposed here.
AGENT_PORT=2024

# Required only by docker-compose.platform.yml. Never commit a real key.
LANGGRAPH_CLOUD_LICENSE_KEY=replace-with-a-valid-langgraph-license-key

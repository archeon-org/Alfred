    # ==========================================================================
    ("Entity", "Entity"): list(EDGE_TYPES.keys()),
}


def get_extraction_types() -> tuple[
    dict[str, type[BaseModel]],
    dict[str, type[BaseModel]],
    dict[tuple[str, str], list[str]],
]:
    """
    Get all entity types, edge types, and edge type map for extraction.
    
    Returns
    -------
    tuple
        (entity_types, edge_types, edge_type_map)
    """
    return ENTITY_TYPES, EDGE_TYPES, EDGE_TYPE_MAP


def get_entity_types() -> dict[str, type[BaseModel]]:
    """Get entity types dictionary for add_episode()."""
    return ENTITY_TYPES


def get_edge_types() -> dict[str, type[BaseModel]]:
    """Get edge types dictionary for add_episode()."""
    return EDGE_TYPES


def get_edge_type_map() -> dict[tuple[str, str], list[str]]:
    """Get edge type map for add_episode()."""
    return EDGE_TYPE_MAP

}


# Edge type map: defines which relationship types are valid between entity pairs
# Format: (source_entity_type, target_entity_type) -> [allowed_relationship_types]
# Note: This is a subset of common pairings. The LLM can still use any relationship
# type for entity pairs not listed here (defaulting to RELATES_TO behavior).
EDGE_TYPE_MAP: dict[tuple[str, str], list[str]] = {
    # Person relationships
    ("Person", "Organization"): ["WORKS_AT", "PART_OF", "INTERACTS", "OWNS_OR_MANAGES", "FOUNDED_BY"],

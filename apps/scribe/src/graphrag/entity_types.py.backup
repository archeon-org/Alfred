    ("Person", "Diagnosis"): ["DIAGNOSED_WITH"],
    ("Person", "Medication"): ["PRESCRIBED_FOR", "ALLERGIC_TO"],
    ("Person", "Allergy"): ["HAS_PROPERTY", "ALLERGIC_TO"],

"""
Simplified Entity and Relationship Types for Graphiti Knowledge Graph

Focused on the most essential entity types and relationships for personal document management.
Optimized for faster extraction and lower LLM costs while maintaining rich semantic structure.
"""

from __future__ import annotations

from pydantic import BaseModel


# =============================================================================
# CORE ENTITY TYPES (15 essential types instead of 87)
# =============================================================================

class Person(BaseModel):
    """Any individual person - name, contact, author, family member, professional."""
    pass


class Organization(BaseModel):
    """Any company, institution, or group - businesses, hospitals, agencies, schools."""
    pass


class Location(BaseModel):
    """Any place - addresses, cities, countries, buildings, venues."""
    pass


class Document(BaseModel):
    """Referenced documents - contracts, invoices, certificates, reports, emails."""
    pass


class Book(BaseModel):
    """A book or publication - includes textbooks, novels, manuals,
    guides, ebooks, or any bound publication."""
    pass


class Contract(BaseModel):
    """A legal agreement or contract - includes employment contracts,
    service agreements, NDAs, leases, or binding documents."""
    pass


class Invoice(BaseModel):
    """A billing document - includes invoices, receipts, bills,
    purchase orders, or payment requests."""
    pass


class Report(BaseModel):
    """A formal report or analysis - includes business reports, medical reports,
    financial statements, audit reports, or analytical documents."""
    pass


class Certificate(BaseModel):
    """A certification or credential - includes diplomas, licenses,
    certifications, awards, or official recognitions."""
    pass


class Presentation(BaseModel):
    """A presentation or slideshow - includes PowerPoint, Keynote,
    pitch decks, lectures, or visual presentations."""
    pass


class Spreadsheet(BaseModel):
    """A spreadsheet or data table - includes Excel files, CSV data,
    financial models, or tabular data documents."""
    pass


class Form(BaseModel):
    """A form or template - includes application forms, registration forms,
    questionnaires, surveys, or structured input documents."""
    pass


class Note(BaseModel):
    """A personal note or memo - includes meeting notes, reminders,
    annotations, sticky notes, or informal writings."""
    pass


class Message(BaseModel):
    """A communication message - includes text messages, chat messages,
    instant messages, or short communications."""
    pass


# =============================================================================
# ENTITY TYPES - TIME & EVENTS
# =============================================================================

class Event(BaseModel):
    """A time-bound activity, occurrence, or experience - includes meetings,
    appointments, deadlines, transactions, procedures, incidents, milestones,
    conferences, parties, or any dated happening."""
    pass


class Meeting(BaseModel):
    """A scheduled meeting or gathering - includes business meetings,
    appointments, calls, video conferences, or group discussions."""
    pass


class Deadline(BaseModel):
    """A due date or time limit - includes project deadlines, payment due dates,
    submission deadlines, or time-sensitive milestones."""
    pass


class Milestone(BaseModel):
    """A significant achievement or checkpoint - includes project milestones,
    anniversaries, goals achieved, or notable accomplishments."""
    pass


class Holiday(BaseModel):
    """A holiday or special day - includes national holidays, religious holidays,
    vacation days, or celebrations."""
    pass


class Trip(BaseModel):
    """A journey or travel - includes business trips, vacations, commutes,
    flights, or travel itineraries."""
    pass


class Appointment(BaseModel):
    """A scheduled appointment - includes doctor appointments, interviews,
    consultations, or booked time slots."""
    pass


# =============================================================================
# ENTITY TYPES - PRODUCTS & SERVICES
# =============================================================================

class Product(BaseModel):
    """A commercial product or good - includes software, physical products,
    medications, equipment, devices, or any purchasable item."""
    pass


class Service(BaseModel):
    """A service offering - includes consulting, maintenance, subscriptions,
    support, or any service provided."""
    pass


class Software(BaseModel):
    """A software application or program - includes apps, tools, platforms,
    operating systems, or digital solutions."""
    pass


class Hardware(BaseModel):
    """A physical device or equipment - includes computers, phones, machinery,
    appliances, or electronic devices."""
    pass


class Medication(BaseModel):
    """A medicine or pharmaceutical - includes drugs, prescriptions,
    supplements, treatments, or medical products."""
    pass


class Food(BaseModel):
    """A food item or meal - includes ingredients, dishes, recipes,
    groceries, or consumable items."""
    pass


class Vehicle(BaseModel):
    """A vehicle or transport - includes cars, bikes, planes, trains,
    boats, or any mode of transportation."""
    pass


class Property(BaseModel):
    """Real estate or property - includes houses, apartments, land,
    buildings, or real estate assets."""
    pass


# =============================================================================
# ENTITY TYPES - FINANCIAL
# =============================================================================

class Monetary(BaseModel):
    """A monetary value, price, payment, or financial amount - includes 
    salaries, costs, fees, budgets, invoices, taxes, or any financial figure."""
    pass


class Account(BaseModel):
    """A financial or user account - includes bank accounts, user accounts,
    investment accounts, or subscription accounts."""
    pass


class Transaction(BaseModel):
    """A financial transaction - includes payments, transfers, purchases,
    refunds, or monetary exchanges."""
    pass


class Budget(BaseModel):
    """A budget or financial plan - includes project budgets, personal budgets,
    cost estimates, or financial allocations."""
    pass


class Tax(BaseModel):
    """A tax or levy - includes income tax, sales tax, property tax,
    VAT, or government charges."""
    pass


class Investment(BaseModel):
    """An investment or asset - includes stocks, bonds, real estate investments,
    portfolios, or financial instruments."""
    pass


class Insurance(BaseModel):
    """An insurance policy or coverage - includes health insurance, car insurance,
    life insurance, or protection plans."""
    pass


class Loan(BaseModel):
    """A loan or credit - includes mortgages, personal loans, credit cards,
    financing, or borrowed funds."""
    pass


# =============================================================================
# ENTITY TYPES - MEDICAL & HEALTH
# =============================================================================

class Diagnosis(BaseModel):
    """A medical diagnosis or condition - includes diseases, disorders,
    symptoms, health conditions, or medical findings."""
    pass


class Treatment(BaseModel):
    """A medical treatment or therapy - includes procedures, surgeries,
    therapies, rehabilitation, or medical interventions."""
    pass


class Symptom(BaseModel):
    """A medical symptom or sign - includes pain, fever, discomfort,
    abnormalities, or health indicators."""
    pass


class Prescription(BaseModel):
    """A medical prescription - includes medication orders, dosage instructions,
    treatment plans, or doctor's orders."""
    pass


class HealthMetric(BaseModel):
    """A health measurement - includes blood pressure, weight, heart rate,
    lab results, or vital signs."""
    pass


class Allergy(BaseModel):
    """An allergy or sensitivity - includes food allergies, drug allergies,
    environmental allergies, or adverse reactions."""
    pass


# =============================================================================
# ENTITY TYPES - LEGAL
# =============================================================================

class LegalCase(BaseModel):
    """A legal case or lawsuit - includes court cases, disputes, claims,
    lawsuits, or legal proceedings."""
    pass


class Law(BaseModel):
    """A law, regulation, or legal provision - includes statutes, regulations,
    policies, rules, or legal requirements."""
    pass


class LegalParty(BaseModel):
    """A party in legal proceedings - includes plaintiffs, defendants,
    witnesses, attorneys, or legal representatives."""
    pass


class Clause(BaseModel):
    """A contract clause or provision - includes terms, conditions,
    stipulations, or contractual provisions."""
    pass


class Patent(BaseModel):
    """A patent or intellectual property - includes patents, trademarks,
    copyrights, or IP rights."""
    pass


class Compliance(BaseModel):
    """A compliance requirement - includes regulatory compliance, standards,
    certifications, or legal obligations."""
    pass


# =============================================================================
# ENTITY TYPES - EDUCATION & LEARNING
# =============================================================================

class Course(BaseModel):
    """An educational course or class - includes online courses, university classes,
    training programs, workshops, or learning modules."""
    pass


class Degree(BaseModel):
    """An academic degree or qualification - includes bachelor's, master's, PhD,
    diplomas, or educational credentials."""
    pass


class School(BaseModel):
    """An educational institution - includes schools, universities, colleges,
    training centers, or learning organizations."""
    pass


class Subject(BaseModel):
    """An academic subject or field - includes mathematics, science, history,
    languages, or areas of study."""
    pass


class Exam(BaseModel):
    """An examination or test - includes final exams, certifications,
    assessments, quizzes, or evaluations."""
    pass


class Grade(BaseModel):
    """A grade or score - includes letter grades, percentages, GPA,
    ratings, or performance scores."""
    pass


# =============================================================================
# ENTITY TYPES - TECHNICAL & PROJECTS
# =============================================================================

class Project(BaseModel):
    """A project or initiative - includes work projects, personal projects,
    research projects, or organized endeavors."""
    pass


class Task(BaseModel):
    """A task or to-do item - includes action items, assignments,
    work items, or things to accomplish."""
    pass


class Feature(BaseModel):
    """A product feature or capability - includes software features,
    product capabilities, or functional requirements."""
    pass


class Bug(BaseModel):
    """A bug or issue - includes software bugs, defects, problems,
    errors, or things to fix."""
    pass


class Technology(BaseModel):
    """A technology or technical concept - includes programming languages,
    frameworks, tools, APIs, or technical solutions."""
    pass


class System(BaseModel):
    """A system or infrastructure - includes IT systems, networks,
    platforms, architectures, or technical environments."""
    pass


class Database(BaseModel):
    """A database or data store - includes SQL databases, data warehouses,
    repositories, or data storage systems."""
    pass


class API(BaseModel):
    """An API or interface - includes REST APIs, web services, integrations,
    or programmatic interfaces."""
    pass


class Repository(BaseModel):
    """A code repository - includes Git repos, version control,
    codebases, or source code locations."""
    pass


# =============================================================================
# ENTITY TYPES - ABSTRACT CONCEPTS
# =============================================================================

class Concept(BaseModel):
    """An abstract idea, topic, or subject matter - includes skills, fields
    of study, methodologies, theories, or knowledge domains."""
    pass


class Skill(BaseModel):
    """A skill or ability - includes technical skills, soft skills,
    competencies, or learned abilities."""
    pass


class Goal(BaseModel):
    """A goal or objective - includes personal goals, business objectives,
    targets, aspirations, or desired outcomes."""
    pass


class Strategy(BaseModel):
    """A strategy or plan - includes business strategies, approaches,
    methodologies, or planned courses of action."""
    pass


class Policy(BaseModel):
    """A policy or guideline - includes company policies, rules,
    procedures, or organizational guidelines."""
    pass


class Metric(BaseModel):
    """A metric or KPI - includes performance metrics, measurements,
    statistics, or quantifiable indicators."""
    pass


class Category(BaseModel):
    """A category or classification - includes types, groups, tags,
    labels, or organizational categories."""
    pass


# =============================================================================
# ENTITY TYPES - IDENTIFIERS & REFERENCES
# =============================================================================

class Identifier(BaseModel):
    """A unique identifier or reference number - includes account numbers,
    case IDs, invoice numbers, patient IDs, order numbers, or tracking codes."""
    pass


class URL(BaseModel):
    """A web URL or link - includes website addresses, hyperlinks,
    resource locators, or web references."""
    pass


class PhoneNumber(BaseModel):
    """A phone number - includes mobile numbers, landlines, fax numbers,
    or contact numbers."""
    pass


class EmailAddress(BaseModel):
    """An email address - includes personal emails, work emails,
    or contact email addresses."""
    pass


class SocialMedia(BaseModel):
    """A social media account or handle - includes Twitter, LinkedIn,
    Instagram, Facebook, or social profiles."""
    pass


# =============================================================================
# ENTITY TYPES - PERSONAL & LIFESTYLE
# =============================================================================

class Preference(BaseModel):
    """A user preference, choice, opinion, or personal selection - includes
    settings, favorites, likes, dislikes, or customization choices."""
    pass


class Requirement(BaseModel):
    """A specific need, constraint, or functionality requirement - includes
    project requirements, legal obligations, medical needs, or specifications."""
    pass


class Procedure(BaseModel):
    """A standard operating procedure, process, or sequential instructions -
    includes workflows, treatment protocols, legal processes, or how-to guides."""
    pass


class Hobby(BaseModel):
    """A hobby or interest - includes sports, arts, games, activities,
    or recreational pursuits."""
    pass


class Recipe(BaseModel):
    """A recipe or cooking instructions - includes food recipes, formulas,
    preparation methods, or cooking guides."""
    pass


class Relationship(BaseModel):
    """A personal relationship - includes family ties, friendships,
    romantic relationships, or social connections."""
    pass


class Memory(BaseModel):
    """A personal memory or experience - includes memorable events,
    past experiences, recollections, or life moments."""
    pass


class Wish(BaseModel):
    """A wish or desire - includes wishlists, wants, dreams,
    or things desired."""
    pass


# =============================================================================
# ENTITY TYPES - MEDIA & ENTERTAINMENT
# =============================================================================

class Image(BaseModel):
    """An image or photo - includes photographs, graphics, screenshots,
    illustrations, or visual media."""
    pass


class Video(BaseModel):
    """A video or recording - includes movies, YouTube videos, recordings,
    tutorials, or video content."""
    pass


class Audio(BaseModel):
    """An audio file or recording - includes podcasts, music, voice recordings,
    audiobooks, or sound files."""
    pass


class Music(BaseModel):
    """A music piece or song - includes tracks, albums, playlists,
    compositions, or musical works."""
    pass


class Movie(BaseModel):
    """A movie or film - includes feature films, documentaries,
    shows, series, or video productions."""
    pass


class Podcast(BaseModel):
    """A podcast or audio show - includes podcast episodes, series,
    or audio broadcasts."""
    pass


class Game(BaseModel):
    """A game - includes video games, board games, sports games,
    or recreational games."""
    pass


# =============================================================================
# RELATIONSHIP/EDGE TYPES
# =============================================================================

class WorksAt(BaseModel):
    """Employment or affiliation relationship between a person and an organization."""
    pass


class LocatedIn(BaseModel):
    """Physical or virtual location relationship - where something is located or based."""
    pass


class OwnsOrManages(BaseModel):
    """Ownership, management, or control relationship between entities."""
    pass


class CreatedBy(BaseModel):
    """Authorship or creation relationship - who made or authored something."""
    pass


class RelatesTo(BaseModel):
    """General semantic relationship when no specific type applies."""
    pass


class Mentions(BaseModel):
    """Reference relationship - when one document or entity mentions another."""
    pass


class PartOf(BaseModel):
    """Hierarchical or compositional relationship - when something is part of a larger whole."""
    pass


class HasProperty(BaseModel):
    """Attribute or characteristic relationship - when an entity has a specific property."""
    pass


class Interacts(BaseModel):
    """Interaction relationship - when entities interact, communicate, or transact."""
    pass


class Requires(BaseModel):
    """Dependency or requirement relationship - when something requires or needs another."""
    pass


class PrescribedFor(BaseModel):
    """Medical or treatment relationship - medication/treatment prescribed for condition."""
    pass


class CostsAmount(BaseModel):
    """Financial relationship - the cost or price of something."""
    pass


class ScheduledFor(BaseModel):
    """Temporal relationship - when something is scheduled or planned for a time/date."""
    pass


class AssignedTo(BaseModel):
    """Assignment relationship - when a task, case, or item is assigned to someone."""
    pass


class BelongsTo(BaseModel):
    """Ownership or membership relationship - when something belongs to someone or something."""
    pass


class Contains(BaseModel):
    """Container relationship - when something contains or includes something else."""
    pass


class DependsOn(BaseModel):
    """Dependency relationship - when something depends on something else."""
    pass


class Produces(BaseModel):
    """Production relationship - when something produces or generates something else."""
    pass


class Consumes(BaseModel):
    """Consumption relationship - when something uses or consumes something else."""
    pass


class Provides(BaseModel):
    """Provider relationship - when something provides or supplies something else."""
    pass


class FollowsFrom(BaseModel):
    """Sequential relationship - when something comes after or follows from something else."""
    pass


class PrecedesTo(BaseModel):
    """Preceding relationship - when something comes before something else."""
    pass


class Causes(BaseModel):
    """Causal relationship - when something causes or leads to something else."""
    pass


class Affects(BaseModel):
    """Impact relationship - when something affects or influences something else."""
    pass


class SimilarTo(BaseModel):
    """Similarity relationship - when two things are similar or related."""
    pass


class OpposesTo(BaseModel):
    """Opposition relationship - when two things are opposite or conflicting."""
    pass


class ConnectsTo(BaseModel):
    """Connection relationship - when something connects to something else."""
    pass


class ReportsTo(BaseModel):
    """Reporting relationship - when someone reports to someone else in hierarchy."""
    pass


class SupervisedBy(BaseModel):
    """Supervision relationship - when someone is supervised or managed by another."""
    pass


class AttendedBy(BaseModel):
    """Attendance relationship - when an event is attended by someone."""
    pass


class AuthoredBy(BaseModel):
    """Authorship relationship - when a document is authored by someone."""
    pass


class SignedBy(BaseModel):
    """Signature relationship - when a document is signed by someone."""
    pass


class ApprovedBy(BaseModel):
    """Approval relationship - when something is approved by someone."""
    pass


class PaidBy(BaseModel):
    """Payment relationship - when something is paid by someone."""
    pass


class PaidTo(BaseModel):
    """Payment receipt relationship - when payment is made to someone."""
    pass


class SentTo(BaseModel):
    """Sending relationship - when something is sent to someone or somewhere."""
    pass


class ReceivedFrom(BaseModel):
    """Receipt relationship - when something is received from someone."""
    pass


class ValidUntil(BaseModel):
    """Validity relationship - when something is valid until a certain time."""
    pass


class StartsAt(BaseModel):
    """Start time relationship - when something starts at a certain time."""
    pass


class EndsAt(BaseModel):
    """End time relationship - when something ends at a certain time."""
    pass


class DueOn(BaseModel):
    """Due date relationship - when something is due on a certain date."""
    pass


class BornOn(BaseModel):
    """Birth date relationship - when someone was born on a date."""
    pass


class DiagnosedWith(BaseModel):
    """Diagnosis relationship - when someone is diagnosed with a condition."""
    pass


class TreatedWith(BaseModel):
    """Treatment relationship - when a condition is treated with something."""
    pass


class AllergicTo(BaseModel):
    """Allergy relationship - when someone is allergic to something."""
    pass


class GraduatedFrom(BaseModel):
    """Education relationship - when someone graduated from an institution."""
    pass


class EnrolledIn(BaseModel):
    """Enrollment relationship - when someone is enrolled in a course or program."""
    pass


class CompletedBy(BaseModel):
    """Completion relationship - when something was completed by someone."""
    pass


class ReviewedBy(BaseModel):
    """Review relationship - when something was reviewed by someone."""
    pass


class RatedAs(BaseModel):
    """Rating relationship - when something is rated as a certain score."""
    pass


class TaggedWith(BaseModel):
    """Tagging relationship - when something is tagged with a category or label."""
    pass


class LinkedTo(BaseModel):
    """Link relationship - when something is linked to something else."""
    pass


class ReferencedIn(BaseModel):
    """Reference relationship - when something is referenced in a document."""
    pass


class QuotedFrom(BaseModel):
    """Quotation relationship - when something is quoted from a source."""
    pass


class BasedOn(BaseModel):
    """Derivation relationship - when something is based on something else."""
    pass


class InspiredBy(BaseModel):
    """Inspiration relationship - when something is inspired by something else."""
    pass


class FundedBy(BaseModel):
    """Funding relationship - when something is funded by someone or something."""
    pass


class SponsoredBy(BaseModel):
    """Sponsorship relationship - when something is sponsored by someone."""
    pass


class PartneredWith(BaseModel):
    """Partnership relationship - when entities are partnered together."""
    pass


class CompetesWith(BaseModel):
    """Competition relationship - when entities compete with each other."""
    pass


class AcquiredBy(BaseModel):
    """Acquisition relationship - when something is acquired by someone."""
    pass


class MergedWith(BaseModel):
    """Merger relationship - when entities merge together."""
    pass


class SucceededBy(BaseModel):
    """Succession relationship - when something is succeeded by something else."""
    pass


class ReplacedBy(BaseModel):
    """Replacement relationship - when something is replaced by something else."""
    pass


class UpgradedTo(BaseModel):
    """Upgrade relationship - when something is upgraded to a newer version."""
    pass


class CompatibleWith(BaseModel):
    """Compatibility relationship - when something is compatible with something else."""
    pass


class IntegratesWith(BaseModel):
    """Integration relationship - when something integrates with something else."""
    pass



# General Configuration
ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Worker Configuration
WORKER_HOST=scribe-worker-1
WORKER_CONCURRENCY=2

# Monitoring / Prometheus Pushgateway
METRICS_PUSH_ENABLED=true
PUSHGATEWAY_URL=pushgateway:9091

# Database Configuration (PostgreSQL)
# For Docker: use 'postgres-archeon', for local: use 'localhost'
DATABASE_HOST=postgres-archeon
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

# Redis Configuration (Celery Broker)
# For Docker: use 'redis-archeon', for local: use 'localhost'
REDIS_HOST=redis-archeon
REDIS_PORT=6379
REDIS_PASSWORD=RedisPassword123
REDIS_DB=0

# Redis SSL (for production)
REDIS_SSL=false

# Cloudflare R2 Configuration (S3-compatible storage)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your_account_id.r2.cloudflarestorage.com

# AI Configuration (Fireworks AI)
FIREWORKS_API_KEY=fw_your_fireworks_api_key
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Model Configuration
CLASSIFICATION_MODEL=accounts/fireworks/models/deepseek-v3p1
EMBEDDING_MODEL=fireworks/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=1536

# OCR Configuration (Mistral OCR)
MISTRAL_OCR_BASE_URL=https://api.mistral.ai/v1
MISTRAL_OCR_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_OCR_TIMEOUT=120
MISTRAL_OCR_TABLE_FORMAT=none
MISTRAL_OCR_EXTRACT_HEADER=false
MISTRAL_OCR_EXTRACT_FOOTER=false

# PDF processing
PDF_MAX_PAGES=10

# Trusted hosts (comma-separated, for production)
TRUSTED_HOSTS=localhost,127.0.0.1

# Celery Configuration
# Task settings
CELERY_TASK_ACKS_LATE=true
CELERY_TASK_REJECT_ON_WORKER_LOST=true
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# Worker settings
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=50

# Graphiti Configuration (Knowledge Graph - Second Brain)
# Enable/disable Graphiti features
GRAPHITI_ENABLED=true

# Neo4j Configuration
# For Docker: use 'neo4j-archeon', for local: use 'localhost'
NEO4J_URI=bolt://neo4j-archeon:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=archeon123

# LLM Configuration for Graphiti (using Fireworks AI - OpenAI compatible)
# Graphiti uses OpenAI client, but we point it to Fireworks AI
OPENAI_API_KEY=fw_your_fireworks_api_key
OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
OPENAI_MODEL=accounts/fireworks/models/deepseek-v3p1
OPENAI_EMBEDDING_MODEL=fireworks/qwen3-embedding-8b

# Embedding dimension (must match vector index in Neo4j)
EMBEDDING_DIM=1536
OPENAI_EMBEDDING_DIM=1536

# Graphiti Telemetry
GRAPHITI_TELEMETRY_ENABLED=false

# LangSmith Configuration (LLM Observability - Optional)
# Get your API key from https://smith.langchain.com/
# When enabled, all LLM calls are traced for debugging and cost analysis
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=archeon-scribe
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com  # Optional: for self-hosted

# Internal Service Configuration
INTERNAL_API_KEY=your-internal-api-key-change-in-production

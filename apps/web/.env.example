# Only VITE_ variables are embedded in the public browser bundle.
VITE_API_URL=/api

# Server-side Vite development proxy. It is never embedded in the browser bundle.
ALFRED_DEV_API_PROXY_TARGET=http://127.0.0.1:3000

# Opt-in browser event viewer, localStorage capture and JSON download. Restart Vite after changing.
VITE_DEBUG_EVENTS=false

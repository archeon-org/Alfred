{
  "name": "@alfred/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint . --max-warnings=0",
    "clean": "rm -rf dist coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "ts-node src/database/run-migrations.ts",
    "migration:run:prod": "node dist/database/run-migrations.js",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "schema:check": "ts-node src/database/check-schema-drift.ts",
    "schema:check:prod": "node dist/database/check-schema-drift.js",
    "workspace:provision": "ts-node src/database/provision-workspace.ts",
    "workspace:provision:prod": "node dist/database/provision-workspace.js"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.59",
    "@alfred/contracts": "workspace:*",
    "@aws-sdk/client-s3": "3.1134.0",
    "@langchain/langgraph-sdk": "1.10.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@prometheus-io/client": "^0.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "mammoth": "1.11.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "7.8.1",
    "sharp": "0.35.4",
    "typeorm": "^0.3.31",
    "unpdf": "1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@ag-ui/client": "0.0.59",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.13.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.17.2",
    "@vitest/coverage-v8": "^4.1.1",
    "ts-node": "^10.9.2",
    "typescript": "catalog:",
    "unplugin-swc": "^1.5.7",
    "vitest": "^4.1.1"
  }
}

# Copy to a private environment file (apps/api/.env, used by `pnpm dev:api`). Never commit real
# credentials. Key order mirrors the `pnpm setup:env` generator and the repository-root .env.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
API_PREFIX=api
API_CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0

# Existing private LangGraph server; reached by the API only, never by the browser.
AGENT_RUNTIME_URL=http://localhost:8000
AGENT_RUNTIME_ASSISTANT_ID=orchestrator
# Stateless graph that titles a chat from its first message; empty disables the title agent.
AGENT_RUNTIME_TITLE_ASSISTANT_ID=title_agent
# Optional API-only cursor encryption override (at least 32 random characters).
# When blank, derived from AUTH_JWT_SECRET; replicas must use the same existing JWT secret.
# Rotating AUTH_JWT_SECRET changes derived cursor keys. Set an explicit key to rotate separately.
EXECUTION_CURSOR_KEY=
EXECUTION_CURSOR_KEY_PREVIOUS=
# Alfred execution and observer limits; no LangGraph platform configuration changes are required.
EXECUTION_DEADLINE_MS=600000
EXECUTION_LEASE_MS=30000
EXECUTION_WORKER_CONCURRENCY=4
EXECUTION_MAX_ACTIVE_PER_USER=4
EXECUTION_MAX_ACTIVE_GLOBAL=64
# Streamed output is committed at most once per window (100-5000 ms); heartbeats never commit.
EXECUTION_COMMIT_WINDOW_MS=500
EXECUTION_CURSOR_TTL_MS=3600000
EXECUTION_SSE_HEARTBEAT_MS=25000
EXECUTION_SSE_DRAIN_TIMEOUT_MS=10000
EXECUTION_SSE_MAX_FRAME_BYTES=2097152
EXECUTION_SSE_MAX_BUFFERED_BYTES=4194304
EXECUTION_MAX_OBSERVERS_PER_USER=4
EXECUTION_MAX_OBSERVERS_PER_INSTANCE=128
EXECUTION_OBSERVER_REAUTH_MS=25000

# PostgreSQL from the sibling langgraph-agent-repo platform stack (docker compose up -d postgres).
# Every API-owned table, including the TypeORM ledger, carries the api_ prefix in that database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph?schema=public
# Personal/project context document UTF-8 limit (1..65536).
CONTEXT_DOCUMENT_MAX_BYTES=65536
# Personal skills: limits include every retained version; imports never execute scripts.
SKILLS_MAX_FILES=50
SKILLS_MAX_PACKAGE_BYTES=1048576
SKILLS_MAX_INSTRUCTIONS_BYTES=131072
SKILLS_MAX_TOTAL_BYTES_PER_USER=26214400
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# Authentication and browser origin
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_JWT_ISSUER=alfred-api
AUTH_JWT_AUDIENCE=alfred-web
AUTH_ACCESS_TOKEN_TTL_SECONDS=300
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_SESSION_CLEANUP_INTERVAL_SECONDS=3600
AUTH_SESSION_RETENTION_SECONDS=2592000
AUTH_COOKIE_SECURE=false
AUTH_IP_RATE_LIMIT_PER_MINUTE=6000
# Independent pre-authentication buckets retain abuse controls behind enterprise NAT.
AUTH_OAUTH_START_IP_RATE_LIMIT_PER_MINUTE=300
AUTH_OAUTH_CALLBACK_IP_RATE_LIMIT_PER_MINUTE=600
AUTH_REFRESH_IP_RATE_LIMIT_PER_MINUTE=1200
AUTH_USER_RATE_LIMIT_PER_MINUTE=120
WEB_APP_URL=http://localhost:5173

# Feature flags. The API is authoritative; only product flags enter the public manifest.
FEATURE_AGENT_RUNTIME_ENABLED=false
FEATURE_AG_UI_STREAMING_ENABLED=false
FEATURE_FILE_UPLOADS_ENABLED=false
FEATURE_GENERATIVE_UI_ENABLED=false
FEATURE_GOOGLE_OAUTH_ENABLED=false
FEATURE_MCP_APPS_ENABLED=false
FEATURE_OUTPUT_STYLES_ENABLED=false
FEATURE_KNOWLEDGE_SCOPE_ENABLED=false
FEATURE_CONVERSATION_FEEDBACK_ENABLED=false
FEATURE_OPENAPI_ENABLED=true
FEATURE_RATE_LIMITING_ENABLED=true
FEATURE_RUNTIME_MEMORY_ENABLED=false
FEATURE_SKILLS_ENABLED=false
FEATURE_TEAMS_ENABLED=false
FEATURE_TRACE_LINKS_ENABLED=false

# Trace links (development diagnostic only): a "Trace" control under each answer opens the run in
# the runtime's LangSmith console. Fill the organisation and project ids from any trace URL
# (`/o/<organisation>/projects/p/<project>/`), then enable the flag. Refused in production.
TRACE_LINK_UI_URL=https://smith.langchain.com
TRACE_LINK_ORGANIZATION_ID=
TRACE_LINK_PROJECT_ID=

# External/commercial Google OAuth. All three values are required when enabled.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=
# Optional restriction for a Google Workspace deployment.
GOOGLE_WORKSPACE_DOMAIN=

# Redis-backed throttling and readiness, from the same platform stack (docker compose up -d redis).
REDIS_URL=redis://localhost:6379/0

# Structured logs and an opt-in, token-protected Prometheus endpoint.
OBSERVABILITY_LOG_LEVEL=info
OBSERVABILITY_METRICS_ENABLED=false
OBSERVABILITY_METRICS_TOKEN=replace-with-a-dedicated-metrics-token-at-least-32-characters

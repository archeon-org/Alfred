# Runtime
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
API_PREFIX=api
API_CORS_ORIGINS=http://localhost:5173

# PostgreSQL (the local compose stack and LangGraph Platform may share the server,
# but each application must use its own database/schema and credentials).
DATABASE_URL=postgresql://alfred:change-me@localhost:5432/alfred_api?schema=public

# Application
NODE_ENV=development
PORT=3000

# Swagger Documentation
SWAGGER_ENABLED=true
DOCS_USER=your_docs_username
DOCS_PASSWORD=your_docs_password

# Database
# For Docker: use 'postgres-archeon', for local: use 'localhost'
DATABASE_TYPE=postgres
DATABASE_HOST=postgres-archeon
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres
DATABASE_SSL=false

# JWT
ACCESS_TOKEN_SECRET=your_access_token_secret_change_in_production
ACCESS_TOKEN_EXPIRATION=300
IGNORE_JWT_EXPIRATION=true

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your_account_id.r2.cloudflarestorage.com

# Redis Configuration
# For Docker: use 'redis-archeon', for local: use 'localhost'
REDIS_HOST=redis-archeon
REDIS_PORT=6379
REDIS_PASSWORD=RedisPassword123

# Fireworks AI API Key
FIREWORKS_API_KEY=fw_your_fireworks_api_key

# Internal API key for Gate -> Scribe communication
INTERNAL_API_KEY=your-internal-api-key-change-in-production
SCRIBE_API_URL=http://archeon-scribe-api:8000
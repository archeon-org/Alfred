{
  "name": "archeon",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start:dev": "expo start",
    "start:clean": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "bump": "node scripts/bump-version.js",
    "release": "node scripts/release.js",
    "prebuild:ios": "expo prebuild --platform ios",
    "run:ios:device": "expo run:ios --device",
    "prebuild:android": "expo prebuild --platform android",
    "run:android:device": "expo run:android --device",
    "build:ios:store:prev": "eas build --platform ios --profile preview --local",
    "build:android:store:prev": "eas build --platform android --profile preview --local",
    "build:ios:local:prod": "node scripts/release.js --build --platform ios --local",
    "submit:ios:store:prod": "eas submit --platform ios --profile production",
    "build:android:local:prod": "node scripts/release.js --build --platform android --local",
    "submit:android:store:prod": "eas submit --platform android --profile production",
    "eas-build-post-install": "cd ../.. && yarn build:packages"
  },
  "dependencies": {
    "@archeon-org/types": "*",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.90.10",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "expo": "~54.0.25",
    "expo-auth-session": "^7.0.9",
    "expo-constants": "~18.0.10",
    "expo-crypto": "^15.0.7",
    "expo-dev-client": "~6.0.18",
    "expo-document-picker": "^14.0.7",
    "expo-file-system": "^19.0.19",
    "expo-font": "~14.0.9",
    "expo-image-picker": "~17.0.8",
    "expo-linking": "~8.0.9",
    "expo-print": "^15.0.7",
    "expo-router": "~6.0.15",
    "expo-secure-store": "^15.0.7",
    "expo-sharing": "~14.0.7",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.9",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-document-scanner-plugin": "^2.0.2",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "autoprefixer": "^10.4.22",
    "chalk": "^4.1.2",
    "inquirer": "^8.0.0",
    "postcss": "^8.5.6",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-test-renderer": "19.1.0",
    "semver": "^7.7.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  },
  "private": true
}

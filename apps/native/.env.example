# =============================================================================
# Archeon Native - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Options: local, development, production
EXPO_PUBLIC_ENV=local

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Gate API base URL (search/chat/question all go through Gate)
#
# For local development with physical device, use ngrok:
#   1. Run ngrok: ngrok http 3000
#   2. Copy the https URL (e.g., https://abc123.ngrok-free.app)
#   3. Set: EXPO_PUBLIC_API_URL=https://abc123.ngrok-free.app/api
#
# For iOS Simulator: EXPO_PUBLIC_API_URL=http://localhost:3000/api
# For Android Emulator: EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
# For Development: EXPO_PUBLIC_API_URL=https://gate.dev.egobis.cloud/api
# For Production: EXPO_PUBLIC_API_URL=https://gate.egobis.cloud/api
#
EXPO_PUBLIC_API_URL=http://localhost:3000/api

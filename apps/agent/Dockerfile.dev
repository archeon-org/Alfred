FROM python:3.12.14-slim-bookworm@sha256:0f5b26b9518d002b6173fd61daad821fa340635ebfec5bba471013f9ca114579

RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_CACHE_DIR=/tmp/uv-cache \
    UV_LINK_MODE=copy

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.10.9@sha256:10902f58a1606787602f303954cea099626a4adb02acbac4c69920fe9d278f82 /uv /uvx /bin/
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --group local-server --no-install-project

COPY langgraph.json ./
COPY src ./src
RUN uv sync --frozen --no-dev --group local-server \
    && python -m pip uninstall -y pip \
    && rm -rf /usr/local/lib/python3.12/ensurepip \
    && rm -f /bin/uv /bin/uvx

RUN useradd --create-home --uid 10001 alfred \
    && mkdir -p /app/.langgraph_api \
    && rm -rf /tmp/uv-cache \
    && mkdir -p /tmp/uv-cache \
    && chown -R alfred:alfred /app /tmp/uv-cache
USER alfred

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD ["python", "-c", "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/ok', timeout=2)"]

CMD ["/app/.venv/bin/langgraph", "dev", "--host", "0.0.0.0", "--port", "8000", "--no-browser"]

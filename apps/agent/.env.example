# Standalone Agent Server contract for docker-compose.platform.yml. Point at a database and a Redis
# logical database reserved on the shared langgraph-agent-repo platform services; never reuse the
# `langgraph` database owned by the platform's own server.
DATABASE_URI=postgres://postgres:postgres@postgres:5432/alfred_langgraph?sslmode=disable
REDIS_URI=redis://redis:6379/1
LANGGRAPH_CLOUD_LICENSE_KEY=replace-with-a-valid-langgraph-license-key

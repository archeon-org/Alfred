{
  "$schema": "https://raw.githubusercontent.com/microsoft/pyright/main/packages/pyright/schema/pyrightconfig.schema.json",
  "include": [
    "apps/scribe/src",
    "apps/scribe/tests"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.mypy_cache",
    "**/node_modules"
  ],
  "venvPath": "apps/scribe",
  "venv": ".venv",
  "executionEnvironments": [
    {
      "root": "apps/scribe/src",
      "extraPaths": [
        "apps/scribe/src"
      ]
    },
    {
      "root": "apps/scribe/tests",
      "extraPaths": [
        "apps/scribe/src"
      ]
    }
  ]
}

{
  "name": "archeon",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "start": "node scripts/start",
    "docker:up": "docker-compose -f ./docker/docker-compose.yml up -d",
    "prettier:write": "prettier --write \"**/*.{js,ts,css,scss,html,tsx,jsx}\"",
    "prettier:check": "prettier --check \"**/*.{js,ts,css,scss,html,tsx,jsx}\"",
    "lint:all": "cd apps/back && npm run lint",
    "build:packages": "yarn workspace @archeon-org/types build",
    "postinstall": "yarn build:packages",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "author": "",
  "license": "ISC",
  "keywords": [],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "inquirer": "^8.0.0",
    "prettier": "^3.2.5",
    "pretty-quick": "^4.0.0"
  },
  "dependencies": {
    "expo": "~54.0.25",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "^4.1.5"
  }
}

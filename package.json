{
  "name": "archeon",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "start": "node scripts/start",
    "ansible": "./scripts/ansible/ansible.sh",
    "docker:dev": "docker-compose -f ./docker/docker-compose.local.yml up -d",
    "docker:dev:build": "docker-compose -f ./docker/docker-compose.local.yml up -d --build",
    "docker:dev:logs": "node scripts/dev-logs.js",
    "docker:dev:down": "docker-compose -f ./docker/docker-compose.local.yml down",
    "docker:dev:restart": "docker-compose -f ./docker/docker-compose.local.yml restart",
    "prettier:write": "prettier --write \"**/*.{js,ts,css,scss,html,tsx,jsx}\"",
    "prettier:check": "prettier --check \"**/*.{js,ts,css,scss,html,tsx,jsx}\"",
    "style:check:gate": "yarn --cwd apps/gate eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "style:check:native": "yarn prettier --check \"apps/native/src/**/*.{ts,tsx}\" \"apps/native/test/**/*.{ts,tsx}\" \"apps/native/scripts/**/*.js\" \"apps/native/*.js\" \"apps/native/*.ts\" \"apps/native/*.json\"",
    "style:check:scribe": "yarn format:scribe:check && yarn lint:scribe",
    "style:check": "yarn style:check:gate && yarn style:check:native && yarn style:check:scribe",
    "style:fix:gate": "yarn --cwd apps/gate eslint \"{src,test}/**/*.ts\" --fix",
    "style:fix:native": "yarn prettier --write \"apps/native/src/**/*.{ts,tsx}\" \"apps/native/test/**/*.{ts,tsx}\" \"apps/native/scripts/**/*.js\" \"apps/native/*.js\" \"apps/native/*.ts\" \"apps/native/*.json\"",
    "style:fix:scribe": "yarn format:scribe && yarn lint:scribe:fix",
    "style:fix": "yarn style:fix:gate && yarn style:fix:native && yarn style:fix:scribe",
    "format:scribe": "cd apps/scribe && ruff format src/ tests/",
    "format:scribe:check": "cd apps/scribe && ruff format --check src/ tests/",
    "lint:scribe": "cd apps/scribe && ruff check src/ tests/",
    "lint:scribe:fix": "cd apps/scribe && ruff check --fix src/ tests/",
    "typecheck:scribe": "cd apps/scribe && mypy src/",
    "coverage:gate": "cd apps/gate && yarn test --coverage --coverageDirectory ../coverage/gate",
    "coverage:scribe": "cd apps/scribe && PYTHONPATH=src uv run --frozen pytest -o addopts=\"-v\" --cov=src --cov-report=term-missing --cov-report=lcov:../coverage/scribe.lcov",
    "coverage:native": "cd apps/native && yarn test:coverage",
    "coverage:merge": "node scripts/coverage/merge-lcov-report.mjs",
    "coverage:all": "yarn coverage:gate && yarn coverage:scribe && yarn coverage:native && yarn coverage:merge",
    "coverage:badges": "node scripts/coverage/update-badges.mjs",
    "coverage:all:badges": "yarn coverage:all && yarn coverage:badges",
    "build:packages": "yarn workspace @archeon-org/types build && yarn workspace @archeon-org/database build && yarn workspace @archeon-org/module build",
    "postinstall": "yarn build:packages",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "author": "",
  "license": "UNLICENSED",
  "keywords": [],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "inquirer": "^8.0.0",
    "prettier": "^3.2.5",
    "pretty-quick": "^4.0.0"
  },
  "dependencies": {
    "expo": "~54.0.25",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "^4.1.5"
  }
}

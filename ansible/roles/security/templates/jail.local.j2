# ═══════════════════════════════════════════════════
#  Ansible-managed — Fail2ban jail configuration
# ═══════════════════════════════════════════════════

[DEFAULT]
bantime  = {{ fail2ban_bantime }}
findtime = {{ fail2ban_findtime }}
maxretry = {{ fail2ban_maxretry }}
destemail = {{ fail2ban_destemail }}
action   = {{ fail2ban_action }}
backend  = auto
{% if coolify_control_ip is defined and coolify_control_ip | length > 0 %}
ignoreip = 127.0.0.1/8 ::1 {{ coolify_control_ip }}
{% else %}
ignoreip = 127.0.0.1/8 ::1
{% endif %}

# ── SSH jail ────────────────────────────────────
[sshd]
enabled  = true
port     = {{ ssh_port }}
filter   = sshd
maxretry = {{ fail2ban_maxretry }}
bantime  = {{ fail2ban_bantime }}

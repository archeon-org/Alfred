# Archeon Scribe Environment Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

# General configuration
PORT=3000
NODE_ENV=production
ENV=production

# Database configuration
DATABASE_TYPE=postgres
DATABASE_HOST=postgres-archeon
DATABASE_PORT=5432
DATABASE_USERNAME={{ vault_db_user }}
DATABASE_PASSWORD={{ vault_db_password }}
DATABASE_NAME={{ vault_db_name }}
DATABASE_SSL=false

# Redis configuration
REDIS_HOST=redis-archeon
REDIS_PORT=6379
REDIS_PASSWORD={{ vault_redis_password }}

# Cloudflare R2 configuration
R2_ACCOUNT_ID={{ vault_r2_account_id }}
R2_ACCESS_KEY_ID={{ vault_r2_access_key_id }}
R2_SECRET_ACCESS_KEY={{ vault_r2_secret_access_key }}
R2_BUCKET_NAME={{ vault_r2_bucket_name }}
R2_PUBLIC_URL={{ vault_r2_public_url }}

# Fireworks AI API Key
FIREWORKS_API_KEY={{ vault_fireworks_api_key }}
# Archeon Gate Environment Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

# General configuration
PORT={{ vault_gate_port | default('3000') }}
NODE_ENV=production
ENV=production

# Database configuration
DATABASE_TYPE=postgres
DATABASE_HOST=postgres-archeon
DATABASE_PORT=5432
DATABASE_USERNAME={{ vault_db_user }}
DATABASE_PASSWORD={{ vault_db_password }}
DATABASE_NAME={{ vault_db_name }}
DATABASE_SSL=false

# JWT configuration
ACCESS_TOKEN_SECRET={{ vault_access_token_secret }}
ACCESS_TOKEN_EXPIRATION=604800
IGNORE_JWT_EXPIRATION=false
